{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "desktop-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts"]
}
