{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/memory-item.schema.json",
  "title": "Singularity Memory Item",
  "type": "object",
  "required": [
    "id",
    "scope",
    "type",
    "source",
    "title",
    "body"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "type": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "confidence": {
      "type": "string",
      "default": "medium"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_run_id": { "type": ["string", "null"] },
        "source_session_id": { "type": ["string", "null"] },
        "source_tool": { "type": ["string", "null"] },
        "source_file": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "ttl": {
      "type": "object",
      "properties": {
        "created_at": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"] },
        "max_age_seconds": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "conflict_status": {
      "type": "string",
      "default": "none"
    },
    "status": {
      "type": "string",
      "default": "active"
    },
    "author_type": {
      "type": "string",
      "default": "agent"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "paths": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "error_types": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "modules": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "metadata": { "type": "object", "default": {} },
    "tombstone_reason": { "type": ["string", "null"] },
    "rejection_reason": { "type": ["string", "null"] },
    "schema_version": { "type": "integer" }
  },
  "additionalProperties": true
}
