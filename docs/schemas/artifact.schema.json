{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/artifact.schema.json",
  "title": "Singularity Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "kind",
    "run_id",
    "session_id",
    "path"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["stdout", "stderr", "diff", "report", "snapshot", "sandbox", "verification", "edit_plan", "model_message", "prompt_manifest", "command_log", "policy_audit_ref", "generic"]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": ["string", "null"], "default": null },
    "event_id": { "type": ["string", "null"], "default": null },
    "path": { "type": "string", "minLength": 1 },
    "mime_type": { "type": "string", "default": "text/plain" },
    "size_bytes": { "type": "integer", "minimum": 0, "default": 0 },
    "content_hash": { "type": "string", "default": "" },
    "metadata": { "type": "object", "default": {} },
    "redaction_applied": { "type": "boolean", "default": true }
  },
  "additionalProperties": true
}
