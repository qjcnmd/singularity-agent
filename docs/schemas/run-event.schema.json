{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/run-event.schema.json",
  "title": "Singularity Run Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "run_id",
    "session_id",
    "task_id",
    "phase_id",
    "action_id",
    "parent_event_id",
    "timestamp",
    "monotonic_ms",
    "component",
    "severity",
    "summary"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "phase_id": { "type": ["string", "null"] },
    "action_id": { "type": ["string", "null"] },
    "parent_event_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "monotonic_ms": { "type": "integer", "minimum": 0 },
    "component": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error", "critical"]
    },
    "summary": { "type": "string" },
    "payload": { "type": "object", "default": {} },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "policy_decision_id": { "type": ["string", "null"], "default": null },
    "approval_grant_id": { "type": ["string", "null"], "default": null },
    "sandbox_id": { "type": ["string", "null"], "default": null },
    "command_id": { "type": ["string", "null"], "default": null },
    "transaction_id": { "type": ["string", "null"], "default": null },
    "verification_id": { "type": ["string", "null"], "default": null },
    "span_id": { "type": ["string", "null"], "default": null },
    "redaction_applied": { "type": "boolean", "default": true },
    "payload_hash": { "type": "string", "default": "" }
  },
  "additionalProperties": true
}
