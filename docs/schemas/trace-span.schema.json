{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/trace-span.schema.json",
  "title": "Singularity Trace Span",
  "type": "object",
  "required": [
    "span_id",
    "span_type",
    "run_id",
    "session_id",
    "task_id",
    "component",
    "status",
    "started_at"
  ],
  "properties": {
    "span_id": { "type": "string", "minLength": 1 },
    "span_type": { "type": "string", "minLength": 1 },
    "parent_span_id": { "type": ["string", "null"], "default": null },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "component": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["running", "success", "failed", "cancelled", "timeout", "skipped", "blocked"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0, "default": null },
    "event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "artifact_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "metadata": { "type": "object", "default": {} },
    "error_message": { "type": ["string", "null"], "default": null }
  },
  "additionalProperties": true
}
