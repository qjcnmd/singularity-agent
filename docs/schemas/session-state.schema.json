{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/session-state.schema.json",
  "title": "Singularity Session State",
  "description": "Session state models for Singularity sessions",
  "type": "object",
  "anyOf": [
    { "$ref": "#/$defs/SessionSummary" },
    { "$ref": "#/$defs/SessionRun" },
    { "$ref": "#/$defs/SessionDetail" },
    { "$ref": "#/$defs/RecoveryGateDecision" }
  ],
  "$defs": {
    "SessionSummary": {
      "type": "object",
      "required": [
        "session_id",
        "status",
        "state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "blocked", "failed", "cancelled", "interrupted", "needs_review"]
        },
        "state": {
          "type": "string",
          "enum": ["active", "recoverable", "needs_review", "blocked", "closed"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_count": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "last_run_id": {
          "type": ["string", "null"],
          "default": null
        },
        "last_task_id": {
          "type": ["string", "null"],
          "default": null
        },
        "total_turns": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "SessionRun": {
      "type": "object",
      "required": [
        "run_id",
        "session_id",
        "task_id",
        "mode",
        "status",
        "started_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["new", "continue", "resume"]
        },
        "status": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "turns": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "error_code": {
          "type": ["string", "null"],
          "default": null
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "SessionDetail": {
      "type": "object",
      "required": [
        "session_id",
        "status",
        "state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "blocked", "failed", "cancelled", "interrupted", "needs_review"]
        },
        "state": {
          "type": "string",
          "enum": ["active", "recoverable", "needs_review", "blocked", "closed"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SessionRun" },
          "default": []
        },
        "checkpoints": {
          "type": "array",
          "items": { "type": "object" },
          "default": []
        },
        "timeline": {
          "type": "array",
          "items": { "type": "object" },
          "default": []
        },
        "recovery_gate": {
          "anyOf": [
            { "$ref": "#/$defs/RecoveryGateDecision" },
            { "type": "null" }
          ],
          "default": null
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "RecoveryGateDecision": {
      "type": "object",
      "required": [
        "status",
        "can_call_model",
        "decided_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready_to_continue", "ready_to_resume", "needs_review", "blocked"]
        },
        "can_call_model": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "pending_tools": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "pending_approvals": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "active_processes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "open_mutations": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "verification_summary": {
          "anyOf": [
            { "type": "object" },
            { "type": "null" }
          ],
          "default": null
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false
    }
  }
}
