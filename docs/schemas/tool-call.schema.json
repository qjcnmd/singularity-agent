{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miniharness.local/schemas/tool-call.schema.json",
  "title": "MiniHarness Tool Call",
  "type": "object",
  "required": [
    "schema_version",
    "tool_call_id",
    "tool_name",
    "run_id",
    "session_id",
    "task_id",
    "phase",
    "argument_digest",
    "redaction_applied"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "tool_call_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": ["string", "null"] },
    "phase": {
      "type": "string",
      "enum": [
        "proposed",
        "validated",
        "rejected",
        "waiting_approval",
        "approved",
        "scheduled",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "recovered",
        "result_appended"
      ]
    },
    "normalized_arguments": { "type": "object" },
    "argument_digest": { "type": "string", "minLength": 1 },
    "tool_schema_hash": { "type": ["string", "null"] },
    "policy_decision_id": { "type": ["string", "null"] },
    "approval_grant_id": { "type": ["string", "null"] },
    "result": { "type": ["object", "null"] },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error_kind": { "type": ["string", "null"] },
    "redaction_applied": { "type": "boolean" }
  },
  "additionalProperties": true
}
