{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity.local/schemas/approval.schema.json",
  "title": "Singularity ApprovalGrant",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "approved_by",
    "scope"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "session_id": { "type": ["string", "null"], "default": null },
    "approved_at": { "type": "string", "format": "date-time" },
    "grant_id": { "type": "string" },
    "expires_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "single_use": { "type": "boolean", "default": true },
    "reason": { "type": "string", "default": "" },
    "operator_signature": { "type": ["string", "null"], "default": null }
  },
  "additionalProperties": false
}
